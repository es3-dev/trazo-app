# Nombre DNS público ya apuntado a la IP del servidor (por ejemplo, trazo.midominio.com)
TRAZO_DOMAIN=trazo.example.com
POSTGRES_DB=trazo_db
POSTGRES_USER=trazo
# Use valores hexadecimales para evitar caracteres especiales en DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASENA
JWT_SECRET=CAMBIE_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
MAX_FILE_SIZE=10485760
